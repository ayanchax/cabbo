# Dockerfile.dev

FROM python:3.10-slim-bookworm

# Prevent python from buffering stdout/stderr
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    ENV=dev

WORKDIR /app


# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*
# Note :curl is used by the Docker healthcheck.


# Install uv (Astral) via official installer (bypasses PyPI)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Copy dependency files first (for caching)
COPY pyproject.toml uv.lock ./

# Install dependencies using uv
RUN uv pip install --system .

# Copy application code
COPY . .

RUN chmod +x /app/entrypoint.dev.sh \
    && addgroup --system --gid 10001 cabbo \
    && adduser --system --uid 10001 --ingroup cabbo cabbo \
    && chown -R cabbo:cabbo /app

USER cabbo

# Expose port
EXPOSE 8000


# Start the application by running the dev entrypoint script
CMD ["./entrypoint.dev.sh"]
